# Copie este arquivo para .env.local e preencha com as URLs do seu banco Neon.
# Na Vercel: Storage > seu banco Neon > aba ".env.local" > copie os valores abaixo.

# Conexão com pool (usada pela aplicação)
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require"

# Conexão direta, sem pool (usada pelas migrations do Prisma)
DATABASE_URL_UNPOOLED="postgresql://USUARIO:SENHA@HOST.REGIAO.aws.neon.tech/neondb?sslmode=require"
